# Copy this file to .env. Defaults are intentionally safe for one local host.

# General
TZ=Asia/Taipei
COMPOSE_PROJECT_NAME=ddns-openvpn-proxy

# Directory mounted read-only into the helper and Gluetun containers.
# Put client.ovpn and every referenced certificate/key file here.
OPENVPN_CONFIG_DIR=./config/openvpn
OPENVPN_CONFIG_FILE=client.ovpn

# Optional provider authentication. If the profile contains auth-user-pass,
# Gluetun requires both values here and overrides any file path in that directive.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional override. Leave blank to read the hostname from `remote` in client.ovpn.
DDNS_HOSTNAME=

# DDNS polling. A transient lookup failure keeps the current tunnel running.
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5

# Optional IPv4 DNS server. Blank uses Docker's configured resolver.
DDNS_RESOLVER=

# Bind to loopback by default. Change to 0.0.0.0 only after setting both proxy
# credential pairs and restricting access with the host firewall.
PROXY_BIND_ADDRESS=127.0.0.1
HTTP_PROXY_PORT=8888
SOCKS5_PROXY_PORT=1080

# Gluetun's built-in HTTP proxy.
HTTPPROXY=on
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=
HTTPPROXY_STEALTH=off

# vproxy SOCKS5 authentication. Set both values or leave both blank.
SOCKS5_USER=
SOCKS5_PASSWORD=

# Operations
GLUETUN_CONTAINER_NAME=ddns-openvpn-proxy
GLUETUN_RESTART_TIMEOUT_SECONDS=20
OPENVPN_VERBOSITY=1
VPROXY_LOG=info
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Version-pinned upstream images. Renovate/Dependabot can update these explicitly.
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.1
DDNS_HELPER_IMAGE=docker:29.6.1-cli-alpine3.24
VPROXY_IMAGE=ghcr.io/0x676e67/vproxy:v2.5.5
SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2

# Test/diagnostic override only. Leave blank in production.
DDNS_OVERRIDE_IPS=
