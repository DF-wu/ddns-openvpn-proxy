# Copy this file to .env. Defaults are intentionally safe for one local host:
# Gluetun backend, OpenVPN profile, proxies bound to loopback only.
# Every variable is documented in docs/operations.md; the contract is docs/spec.md.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
TZ=Asia/Taipei
COMPOSE_PROJECT_NAME=ddns-openvpn-proxy

# ---------------------------------------------------------------------------
# Backend and profile selection
# ---------------------------------------------------------------------------
# VPN_TYPE selects the profile adapter; each type belongs to one backend stack:
#   openvpn, wireguard -> docker-compose.yml (Gluetun, default)
#   openconnect        -> docker-compose.openconnect.yml
#   singbox            -> docker-compose.singbox.yml
# For a non-default backend also set COMPOSE_FILE so plain `docker compose`
# commands pick the right stack. `make` and scripts/validate-compose.sh check
# that the two agree.
VPN_TYPE=openvpn
#COMPOSE_FILE=docker-compose.openconnect.yml
#COMPOSE_FILE=docker-compose.singbox.yml

# Host directory mounted read-only into the helper and the VPN container, and
# the profile file inside it. Keep every certificate/key the profile references
# in the same directory.
#   openvpn:     ./config/openvpn     client.ovpn
#   wireguard:   ./config/wireguard   wg0.conf
#   openconnect: ./config/openconnect client.conf
#   singbox:     ./config/sing-box    config.json
VPN_CONFIG_DIR=./config/openvpn
VPN_CONFIG_FILE=client.ovpn

# Optional override. Blank monitors the hostname found in the profile
# (OpenVPN remote, WireGuard Endpoint, sing-box "server") or, for OpenConnect,
# OPENCONNECT_SERVER.
DDNS_HOSTNAME=

# ---------------------------------------------------------------------------
# OpenVPN (Gluetun backend)
# ---------------------------------------------------------------------------
# Required when the profile contains auth-user-pass. Gluetun overrides any
# file path given in that directive.
OPENVPN_USER=
OPENVPN_PASSWORD=
OPENVPN_VERBOSITY=1

# ---------------------------------------------------------------------------
# WireGuard (Gluetun backend)
# ---------------------------------------------------------------------------
# Gluetun imports PrivateKey, Address, PublicKey, PresharedKey, and Endpoint
# from wg0.conf. Routing, keepalive, MTU, and implementation come from here.
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=0
WIREGUARD_MTU=1320
WIREGUARD_IMPLEMENTATION=auto

# ---------------------------------------------------------------------------
# Gluetun privacy and footprint
# ---------------------------------------------------------------------------
# on rewrites DNS answers for listed hostnames and keeps a downloaded blocklist
# in memory (refreshed every 24h through the tunnel).
BLOCK_MALICIOUS=off
# on queries third-party echo services (ipinfo, ...) on every (re)connect and
# logs the exit address.
PUBLICIP_ENABLED=off

# ---------------------------------------------------------------------------
# OpenConnect backend (AnyConnect/ocserv, GlobalProtect, Pulse, F5, Fortinet)
# ---------------------------------------------------------------------------
# Gateway hostname (the DDNS name) and port. Protocol, certificate pinning, and
# other options live in the profile file (OpenConnect --config format).
OPENCONNECT_SERVER=
OPENCONNECT_PORT=443
# Username/password pair; both set or both empty (certificate-only login).
OPENCONNECT_USER=
OPENCONNECT_PASSWORD=
# Optional base32 TOTP secret for MFA prompts, extra CLI flags, reconnect delay.
OPENCONNECT_TOTP_SECRET=
OPENCONNECT_OPTIONS=
OPENCONNECT_RECONNECT_DELAY=30

# ---------------------------------------------------------------------------
# sing-box backend (Shadowsocks, VMess, VLESS, Trojan, Hysteria2, TUIC, ...)
# ---------------------------------------------------------------------------
# DNS server used through the tunnel for proxied client lookups.
SINGBOX_DNS_SERVER=1.1.1.1
# info and below log every proxied destination; keep warn unless debugging.
SINGBOX_LOG_LEVEL=warn
# URL fetched through the proxy by the container healthcheck.
SINGBOX_HEALTH_URL=http://cp.cloudflare.com/generate_204

# ---------------------------------------------------------------------------
# DDNS polling
# ---------------------------------------------------------------------------
# A transient lookup failure keeps the current tunnel running.
DDNS_POLL_SECONDS=60
DDNS_INIT_RETRY_SECONDS=5
# Optional IPv4 DNS server. Blank uses Docker's configured resolver.
DDNS_RESOLVER=

# ---------------------------------------------------------------------------
# Proxy exposure
# ---------------------------------------------------------------------------
# Bind to loopback by default. Change to a LAN address or 0.0.0.0 only after
# setting both proxy credential pairs and restricting access with the host
# firewall. The openconnect backend has no proxy authentication and is
# always loopback-only.
PROXY_BIND_ADDRESS=127.0.0.1
HTTP_PROXY_PORT=8888
SOCKS5_PROXY_PORT=1080

# HTTP proxy (Gluetun built-in or sing-box mixed inbound).
HTTPPROXY=on
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=
# The Gluetun HTTP proxy always runs in stealth mode (no X-Forwarded-For) and
# never logs requests; there is no switch for either.

# SOCKS5 proxy (vproxy sidecar or sing-box mixed inbound). Both or neither.
SOCKS5_USER=
SOCKS5_PASSWORD=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Restart targets. Leave unset to use each stack's defaults: Gluetun
# ddns-openvpn-proxy + ddns-openvpn-vproxy (sidecar), OpenConnect
# ddns-openconnect-proxy, sing-box ddns-singbox-proxy. Legacy
# GLUETUN_CONTAINER_NAME is still accepted as an alias for the Gluetun stack.
#VPN_CONTAINER_NAME=
#VPROXY_CONTAINER_NAME=
VPN_RESTART_TIMEOUT_SECONDS=20
VPN_HEALTH_TIMEOUT_SECONDS=120
# info and below log every proxied destination; keep warn unless debugging.
VPROXY_LOG=warn
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ---------------------------------------------------------------------------
# Version-pinned upstream images. Renovate/Dependabot can update these explicitly.
# ---------------------------------------------------------------------------
DDNS_HELPER_IMAGE=docker:29.6.1-cli-alpine3.24
SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.1
VPROXY_IMAGE=ghcr.io/0x676e67/vproxy:v2.5.5
OPENCONNECT_IMAGE=wazum/openconnect-proxy:2.1.0
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.14.2

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# Test/diagnostic override only. Leave blank in production.
DDNS_OVERRIDE_IPS=
