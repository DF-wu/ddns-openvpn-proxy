# Timezone used in logs.
TZ=UTC

# VPN type: openvpn or wireguard.
VPN_TYPE=openvpn

# Directory containing your source OpenVPN files.
# Put exactly one .ovpn under ./config/openvpn/ unless OPENVPN_SOURCE_CONFIG is set.
OPENVPN_CONFIG_DIR=./config

# Optional explicit path to the source .ovpn profile.
# Leave blank to auto-detect the only .ovpn in ./config/openvpn/.
OPENVPN_SOURCE_CONFIG=

# Directory containing your source WireGuard files.
# This is used by the local validator only. Both protocols share the same
# Docker volume mount (OPENVPN_CONFIG_DIR). WireGuard configs are read from
# ./config/wireguard/ within the mounted directory.
WIREGUARD_CONFIG_DIR=./config

# Optional explicit path to the source WireGuard .conf profile.
# Leave blank to auto-detect the only .conf in ./config/wireguard/.
WIREGUARD_SOURCE_CONFIG=

# Directory for rendered runtime state.
STATE_DIR=./state

# Optional explicit hostname to watch.
# Leave blank to parse the hostname from the primary 'remote' line (OpenVPN)
# or the 'Endpoint' line (WireGuard) in the source config.
DDNS_HOSTNAME=vpn.example.com

# Polling and restart debounce.
DDNS_POLL_SECONDS=60
DDNS_COOLDOWN_SECONDS=15

# ddns-init retry policy. 0 means retry forever until the first render succeeds.
DDNS_INIT_RETRY_SECONDS=5
DDNS_INIT_MAX_ATTEMPTS=0

# Optional DNS resolver IP for the watcher. Leave blank to use the container default resolver.
DDNS_RESOLVER=

# HTTP proxy listener published from Gluetun.
HTTP_PROXY_PORT=8888

# Optional HTTP proxy authentication.
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=

# Hide proxy headers from upstream servers. Keep off unless you specifically need it.
HTTPPROXY_STEALTH=off

# Published port for the SOCKS5 proxy sidecar (vproxy).
SOCKS5_PROXY_PORT=1080

# Optional SOCKS5 authentication. Leave blank for open access.
SOCKS5_USER=
SOCKS5_PASSWORD=

# vproxy image reference.
VPROXY_IMAGE=ghcr.io/0x676e67/vproxy:latest

# Name of the Gluetun container to restart when the DDNS target changes.
GLUETUN_CONTAINER_NAME=ddns-openvpn-proxy

# Published watcher image. This image runs both ddns-init and ddns-watcher.
WATCHER_IMAGE=ghcr.io/df-wu/ddns-openvpn-proxy-watcher:latest

# Optional explicit source config path inside the mounted source directory contract.
# Example: ./config/openvpn/client.ovpn or ./config/wireguard/wg0.conf
# Leave blank to auto-detect the only config file.
# OPENVPN_SOURCE_CONFIG=./config/openvpn/client.ovpn
# WIREGUARD_SOURCE_CONFIG=./config/wireguard/wg0.conf

# Gluetun image reference.
GLUETUN_IMAGE=qmcgaw/gluetun:latest

# Optional: test override only. Leave empty in normal use.
DDNS_OVERRIDE_IP=
