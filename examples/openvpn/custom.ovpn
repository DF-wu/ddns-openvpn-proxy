client
dev tun
proto udp
nobind
resolv-retry infinite
remote-cert-tls server
persist-key
persist-tun
ping 10
ping-restart 60

# Keep the hostname here. The helper renders a separate IPv4 runtime profile.
remote vpn.example.com 1194 udp

<ca>
-----BEGIN CERTIFICATE-----
REPLACE_WITH_YOUR_CA_CERTIFICATE
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
REPLACE_WITH_YOUR_CLIENT_CERTIFICATE
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
REPLACE_WITH_YOUR_CLIENT_PRIVATE_KEY
-----END PRIVATE KEY-----
</key>
